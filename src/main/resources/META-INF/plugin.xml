<?xml version="1.0" encoding="UTF-8" ?>
<idea-plugin>
    <id>com.codesage.plugin</id>
    <name>CodeSage</name>
    <vendor>CodeSage Team</vendor>
    <description
    ><![CDATA[
        AI-powered coding assistant for IntelliJ IDEA.<br/>
        Supports multiple models (MiniMax, Kimi), skill system, and MCP protocol.
    ]]></description>
    <version>2026.1.2</version>
    <depends>com.intellij.modules.platform</depends>

    <extensionPoints>
        <extensionPoint
            name="skillProvider"
            interface="com.codesage.skill.SkillProvider"
            dynamic="true"
        />
        <extensionPoint
            name="toolProvider"
            interface="com.codesage.agent.tools.ToolProvider"
            dynamic="true"
        />
        <extensionPoint
            name="agentHook"
            interface="com.codesage.agent.core.AgentHooks"
            dynamic="true"
        />
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Application Level Services -->
        <applicationService
            serviceImplementation="com.codesage.shared.config.PluginConfig"
        />
        <applicationService
            serviceImplementation="com.codesage.shared.config.SettingsRepository"
        />
        <applicationService
            serviceImplementation="com.codesage.plugin.CodeSageAppService"
        />

        <!-- Project Level Services -->
        <projectService
            serviceImplementation="com.codesage.plugin.CodeSageProjectService"
        />

        <!-- Settings Page -->
        <applicationConfigurable
            parentId="tools"
            instance="com.codesage.ide.settings.PluginSettingsConfigurable"
            id="com.codesage.ide.settings.PluginSettingsConfigurable"
            displayName="CodeSage"
        />
        <applicationConfigurable
            parentId="com.codesage.ide.settings.PluginSettingsConfigurable"
            instance="com.codesage.ide.settings.ProviderSettingsConfigurable"
            id="com.codesage.ide.settings.ProviderSettingsConfigurable"
            displayName="Providers &amp; General"
        />
        <applicationConfigurable
            parentId="com.codesage.ide.settings.PluginSettingsConfigurable"
            instance="com.codesage.ide.settings.BudgetSettingsConfigurable"
            id="com.codesage.ide.settings.BudgetSettingsConfigurable"
            displayName="Budget &amp; Rounds"
        />

        <!-- Tool Window -->
        <toolWindow
            id="CodeSage"
            anchor="right"
            factoryClass="com.codesage.ide.toolwindow.AgentToolWindowFactory"
            icon="/icons/codesage.svg"
        />

        <!-- Post Startup Activity -->
        <postStartupActivity
            implementation="com.codesage.plugin.CodeSageStartupActivity"
        />
    </extensions>

    <actions>
        <group id="CodeSage.MainMenu" text="CodeSage">
            <add-to-group group-id="MainMenu" anchor="last" />
        </group>

        <action
            id="CodeSage.OpenWindow"
            class="com.codesage.ide.actions.OpenAgentWindowAction"
            text="打开 AI Assistant"
            description="打开CodeSage AI助手窗口"
        >
            <add-to-group group-id="ToolsMenu" anchor="last" />
            <keyboard-shortcut
                keymap="$default"
                first-keystroke="ctrl shift S"
            />
        </action>

        <action
            id="CodeSage.OpenSettingsFolder"
            class="com.codesage.ide.actions.OpenSettingsFolderAction"
            text="打开设置文件夹"
            description="在系统文件管理器中打开 ~/codesage/ 目录"
        >
            <add-to-group group-id="CodeSage.MainMenu" anchor="first" />
        </action>

        <action
            id="CodeSage.OpenSettingsFile"
            class="com.codesage.ide.actions.OpenSettingsFileAction"
            text="编辑 settings.json"
            description="在 IDE 编辑器中打开 settings.json"
        >
            <add-to-group
                group-id="CodeSage.MainMenu"
                anchor="after"
                relative-to-action="CodeSage.OpenSettingsFolder"
            />
        </action>

        <action
            id="CodeSage.ReloadSettings"
            class="com.codesage.ide.actions.ReloadSettingsAction"
            text="重载设置"
            description="从磁盘重新读取 settings.json"
        >
            <add-to-group
                group-id="CodeSage.MainMenu"
                anchor="after"
                relative-to-action="CodeSage.OpenSettingsFile"
            />
        </action>

        <action
            id="CodeSage.AnalyzeSelection"
            class="com.codesage.ide.actions.AnalyzeSelectionAction"
            text="AI 分析代码"
            description="使用AI分析选中的代码"
        >
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
            <keyboard-shortcut
                keymap="$default"
                first-keystroke="ctrl shift A"
            />
        </action>

        <!-- Inline Chat Actions -->
        <action
            id="CodeSage.OpenInlineChat"
            class="com.codesage.ide.inline.actions.OpenInlineChatAction"
            text="CodeSage Inline Chat"
            description="在编辑器内打开 AI 对话"
        >
            <add-to-group group-id="EditorPopupMenu" anchor="first" />
            <keyboard-shortcut
                keymap="$default"
                first-keystroke="alt shift ENTER"
            />
        </action>

        <action
            id="CodeSage.ExplainCode"
            class="com.codesage.ide.inline.actions.ExplainCodeAction"
            text="Explain with CodeSage"
        >
            <add-to-group
                group-id="EditorPopupMenu"
                anchor="after"
                relative-to-action="CodeSage.OpenInlineChat"
            />
        </action>

        <action
            id="CodeSage.RefactorCode"
            class="com.codesage.ide.inline.actions.RefactorCodeAction"
            text="Refactor with CodeSage"
        >
            <add-to-group
                group-id="EditorPopupMenu"
                anchor="after"
                relative-to-action="CodeSage.ExplainCode"
            />
        </action>

        <action
            id="CodeSage.GenerateTest"
            class="com.codesage.ide.inline.actions.GenerateTestAction"
            text="Generate Test with CodeSage"
        >
            <add-to-group
                group-id="EditorPopupMenu"
                anchor="after"
                relative-to-action="CodeSage.RefactorCode"
            />
        </action>
    </actions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Inline Chat Intention Action -->
        <intentionAction>
            <className
            >com.codesage.ide.inline.actions.FixErrorIntention</className>
            <category>CodeSage</category>
        </intentionAction>
    </extensions>
</idea-plugin>
